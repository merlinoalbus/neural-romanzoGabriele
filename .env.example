PROJECT_ID=romanzo-gabriele
APP_ENV=production
APP_VERSION=0.1.0
LOG_LEVEL=info

FE_HOST_PORT=3000
MCP_HOST_PORT=3002
MCP_PORT=3002
MCP_URL=https://devrn-romanzo-mcp.nasmerlinoalbus.cloud/mcp
# Backend -> MCP internal endpoint used by the editable chapter-draft cockpit.
MCP_EDITOR_URL=http://localhost:3002
MCP_SHARED_SECRET=change-this-shared-secret
MCP_SSE_KEEPALIVE_MS=25000
MCP_SESSION_TTL_MS=1800000
MCP_SESSION_CLEANUP_INTERVAL_MS=300000
NEO4J_URI=bolt://romanzo_gabriele_neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-this-password-please

# Default: Ollama locale nello stack (servizio romanzo_gabriele_ollama), nessuna chiave a
# pagamento richiesta. Il modello qwen3-embedding-4b-ctx8k viene scaricato e configurato
# automaticamente da romanzo_gabriele_ollama_init al primo avvio (vedi docker-compose.yml).
# Per usare invece un provider esterno (OpenAI, Voyage, ecc.), sovrascrivi questi valori.
# Dopo un cambio di EMBEDDINGS_MODEL, rilancia kg_backfill_embeddings finche' summary.selected=0:
# i vettori del modello precedente vengono rigenerati automaticamente nel nuovo spazio.
EMBEDDINGS_PROVIDER=openai-compatible
EMBEDDINGS_API_KEY=ollama-local
EMBEDDINGS_BASE_URL=http://romanzo_gabriele_ollama:11434/v1
EMBEDDINGS_MODEL=qwen3-embedding-4b-ctx8k
EMBEDDINGS_DIMENSIONS=1536
EMBEDDINGS_TIMEOUT_MS=30000
# Testi per singola richiesta al provider negli embed in batch (array input OpenAI-compatible).
EMBEDDINGS_BATCH_SIZE=32
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_EMBEDDING_MODEL=

# Editorial working state (session/blocks/findings/decisions/rewrites), never a graph node.
# Set by docker-compose.yml to the mounted volume path; override only for bare-metal runs.
EDITING_STATE_DIR=/app/.state/chapter-editing

WATCHTOWER_SCOPE=romanzo-gabriele-neural
